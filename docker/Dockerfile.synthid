# SynthID-Text scoring. Same base as the MarkLLM image; the scheme is selected
# at runtime, so this exists mainly to pin a separate config and cache.
FROM wmtk-markllm:local

ENV WATERMARKS_SYNTHID_PATH=/opt/markllm

ENTRYPOINT ["python", "-m", "wmtk.cli.detect_text_watermark", "--scheme", "synthid"]
CMD ["--help"]

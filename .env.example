# Copy to .env and fill in. .env is gitignored and dockerignored.

# Require a bearer token on every endpoint except /health.
# Generate one with: python -c "import secrets; print(secrets.token_urlsafe(32))"
WATERMARKS_SERVER_API_KEY=

# Key for an OpenAI-compatible rewrite backend (Layer B).
# Read from the environment so it never lands in argv or shell history.
WATERMARKS_REWRITE_API_KEY=

# Path to a MarkLLM checkout, created by scripts/setup_markllm.sh
WATERMARKS_MARKLLM_PATH=

# Limits
WATERMARKS_MAX_INPUT_BYTES=268435456
WATERMARKS_MAX_TEXT_BYTES=33554432
WATERMARKS_SUBPROCESS_TIMEOUT=120
